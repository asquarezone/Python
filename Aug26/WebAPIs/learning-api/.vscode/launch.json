    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "learning_api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "env": {"PYTHONPATH": "${workspaceFolder}/src"},
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "jinja": true
        }
    ]
}